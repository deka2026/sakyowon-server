# 사교원 자체 서버 환경변수 예시 — 실제 값으로 채워 /etc/sakyowon-api.env 에 저장
# (이 파일은 예시일 뿐, 실제 .env 는 절대 git에 올리지 않는다)

# SQLite 파일 경로 (절대경로 권장)
SAKYOWON_DB=/opt/sakyowon/data/sakyowon.db

# 관리자 조회 비밀키 — 길고 무작위하게. 없으면 조회가 전부 차단된다.
SAKYOWON_ADMIN_KEY=change-me-to-a-long-random-string

# (선택) 전환기 CORS 허용 출처. 같은 출처 서빙이면 비워 둔다.
# 예) 정적이 아직 GitHub Pages일 때만 임시로:
# SAKYOWON_ALLOW_ORIGINS=https://sakyowon.co.kr,https://deka2026.github.io

# (선택) 신규 신청·문의 텔레그램 알림
# SAKYOWON_TG_TOKEN=123456:ABC...
# SAKYOWON_TG_CHAT=-1001234567890

# 본진 AI 기능(/api/ai, /api/ai/chat, /api/translate) 재구현용 — 사교원 Anthropic 키.
# 없으면 AI는 안내 메시지/폴백으로만 동작(번역은 프론트가 MyMemory로 폴백).
# SAKYOWON_ANTHROPIC_KEY=sk-ant-...
# SAKYOWON_AI_MODEL=claude-sonnet-5
# SAKYOWON_AI_MODEL_FAST=claude-haiku-4-5-20251001
