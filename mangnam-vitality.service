[Unit]
Description=망남 활력사이트 (Next.js 서버형, SQLite)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/sakyowon/apps/mangnam-vitality
# 배포 전 1회: npm ci && npm run build (아래 start 는 next start -p 3100)
ExecStart=/usr/bin/npm run start
Environment=NODE_ENV=production
# 필요 시 관리자 비번 등 앱 환경변수 파일 (없으면 무시)
EnvironmentFile=-/etc/mangnam-vitality.env
Restart=always
RestartSec=3
User=sakyowon
Group=sakyowon

[Install]
WantedBy=multi-user.target
